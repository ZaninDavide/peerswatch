[Unit]
Description=PeersWatch Server
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=always
RestartSec=1
User=root
ExecStart=/snap/bin/node server.js
WorkingDirectory=/home/andrea/apis/peerswatch/server
EnvironmentFile=/home/andrea/apis/peerswatch/.env

[Install]
WantedBy=multi-user.target