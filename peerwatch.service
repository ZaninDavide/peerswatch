[Unit]
Description=Peerswatch Server
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=always
RestartSec=1
User=root
ExecStart=/home/andrea/apis/peerswatch/server
WorkingDirectory=/home/andrea/apis/peerswatch
EnvironmentFile=/home/andrea/apis/peerswatch/.env

[Install]
WantedBy=multi-user.target